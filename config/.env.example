# Loop configuration template.
# Copy this file to `.env` in the project root and fill in your values.
#   cp config/.env.example .env
# NEVER commit your real .env — it is gitignored.

# --- General ---------------------------------------------------------------
ENVIRONMENT=development            # development | production
TIMEZONE=Europe/Berlin            # IANA timezone name
BRIEFING_TIME=08:00               # HH:MM local time for the morning briefing
FOLLOW_UP_WINDOW_HOURS=48         # flag emails with no reply after this many hours

# --- Local persistence -----------------------------------------------------
DATABASE_URL=sqlite:///data/loop.db
CHROMA_PERSIST_DIR=data/chroma

# --- HTTP API ----------------------------------------------------------------
# Bearer token every /api/v1/* request must present, even from localhost.
# Left blank the API refuses all requests with 401 rather than opening itself.
HTTP_BIND=127.0.0.1
HTTP_PORT=8420
API_BEARER_TOKEN=

# --- Telegram --------------------------------------------------------------
# Create a bot with @BotFather and paste the token below.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Gmail / Google --------------------------------------------------------
# Download OAuth client secrets from Google Cloud Console (Desktop app).
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Outlook / Microsoft Graph ---------------------------------------------
# From your Azure app registration.
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=common          # or your tenant id

# --- Microsoft Teams -------------------------------------------------------
# Bot Framework / Azure app registration for the Teams bot (Phase 2).
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password

# --- Wrike (Phase 2) -------------------------------------------------------
# Permanent API token from Wrike (Apps & Integrations -> API).
WRIKE_API_KEY=your-wrike-api-key

# --- LLM: local (Ollama) — used first, local-first ------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM: cloud fallback (Anthropic) — used only when needed --------------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Cloud fallback triggers if a local response is shorter than this many
# characters or takes longer than the latency budget below.
LLM_FALLBACK_MIN_CHARS=50
LLM_FALLBACK_LATENCY_SECONDS=10.0

# --- Obsidian --------------------------------------------------------------
OBSIDIAN_VAULT_PATH=~/Obsidian/Vault
# Optional second vault whose notes are LOCAL-ONLY (never sent to a cloud LLM).
OBSIDIAN_PRIVATE_VAULT_PATH=

# --- Web dashboard ---------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- LLM routing heuristics ------------------------------------------------
# Cloud fallback triggers when a local response is shorter than this many
# characters, contains a refusal phrase, or exceeds the latency budget.
LOCAL_MIN_RESPONSE_CHARS=40
LOCAL_LATENCY_BUDGET_SECONDS=10.0

# --- Privacy gate ----------------------------------------------------------
# Comma-separated vault names/paths that must NEVER reach a cloud LLM.
PRIVATE_VAULTS=
# Treat all-day personal calendar events as local-only (true/false).
PRIVATE_PERSONAL_CALENDAR=true
# Treat personal (non-group) Telegram chats as local-only (true/false).
PRIVATE_TELEGRAM_PERSONAL=true

# --- Email triage (Phase 3) ------------------------------------------------
# Comma-separated VIP sender addresses. Mail from these people scores higher
# on urgency and importance in the morning briefing.
VIP_SENDERS=boss@company.com,ceo@company.com

# --- Conversation memory (Phase 3) -----------------------------------------
# Conversation sessions expire after this many hours of inactivity.
SESSION_TTL_HOURS=24

# --- Autonomy (Phase 4) ----------------------------------------------------
# How autonomously Loop may act by default, for every action type:
#   observe  record only, never surface proactively
#   suggest  surface a suggestion, prepare nothing
#   approve  prepare the action and wait for your explicit approval  [default]
#   act      execute autonomously, then log it
# Per-action overrides are set at runtime: `loop autonomy-set <action> <level>`.
DEFAULT_AUTONOMY_LEVEL=approve
# Hard ceiling for outbound email, applied ON TOP of any per-action override.
# While this is `approve`, Loop will never send mail unattended no matter what
# the dashboard says. Raising it to `act` is a deliberate decision made here.
MAX_AUTONOMY_EMAIL_SEND=approve

# --- Projects (Phase 4) ----------------------------------------------------
# Projects are discovered from <vault>/Projects/ (PARA). This adds more, as
# comma-separated "Name:keyword1|keyword2" entries.
PROJECTS=

# --- Weekly review (Phase 4) -----------------------------------------------
# When the weekly digest is delivered (mon|tue|wed|thu|fri|sat|sun + HH:MM).
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=18:00

# --- Wrike sync (Phase 4) --------------------------------------------------
# Background sync interval in minutes. Conflict policy is "Wrike wins": tasks
# that exist in both places take Wrike's version, and tasks you captured in
# Loop are pushed up. Pushing also requires wrike_write autonomy at `act`.
WRIKE_SYNC_MINUTES=30
# Optional Wrike folder id that pushed tasks are created in.
WRIKE_FOLDER_ID=

# --- Voice-to-note (Phase 4) -----------------------------------------------
# Requires the optional extra:  pip install -e ".[voice]"
# Transcription runs locally; audio is never sent anywhere.
# Model size: tiny|base|small|medium|large-v3 (bigger = slower, more accurate).
WHISPER_MODEL_SIZE=base
# Device: cpu|cuda|auto
WHISPER_DEVICE=cpu
# Compute type: int8|float16|float32
WHISPER_COMPUTE_TYPE=int8
